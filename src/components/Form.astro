---
import IconComponent from "./IconComponent.astro";
import Spinner from "./spinner.astro";

const { translate } = Astro.props;

const RECAPTCHA_URL: string = import.meta.env.PUBLIC_RECAPTCHA_URL;
const RECAPTCHA_SITE_KEY: string = import.meta.env.RECAPTCHA_SITE_KEY;

interface UIMessageMap {
  required: string;
  email: string;
  form_success: string;
  error_captcha: string;
  error_mail: string;
  error_network: string;
}
const uiMessages: UIMessageMap = {
  required: translate("form_error_required"),
  email: translate("form_error_email"),
  form_success: translate("form_success"),
  error_captcha: translate("error_captcha"),
  error_mail: translate("error_mail"),
  error_network: translate("error_network"),
};
---

<form
  id="contact-form"
  class="space-y-6 font-normal text-xl/10 px-6"
  data-recaptcha-site-key={RECAPTCHA_SITE_KEY}
  data-ui-messages={JSON.stringify(uiMessages)}
  novalidate
>
  <section class="group mb-3">
    <label for="name" class="block">
      {translate("form_label_name")}
      <span class="error-msg text-base text-primary/60 transition-colors" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      autocomplete="name"
      class="w-full border border-black/30 bg-black/15 px-3.75 py-2.5 focus:ring-1 focus:ring-primary focus:border-transparent outline-none dark:border-white/30 dark:bg-white/15 transition-all"
      placeholder={translate("form_placeholder_name")}
      required
      aria-required="true"
    />
  </section>

  <section class="group mb-3">
    <label for="email" class="block">
      {translate("form_label_email")}
      <span class="error-msg text-base text-primary/60 transition-colors" aria-hidden="true">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      autocomplete="email"
      class="w-full border border-black/30 bg-black/15 px-3.75 py-2.5 focus:ring-1 focus:ring-primary focus:border-transparent outline-none dark:border-white/30 dark:bg-white/15 transition-all"
      placeholder={translate("form_placeholder_email")}
      required
      aria-required="true"
    />
  </section>

  <section class="group mb-3">
    <label for="subject" class="block">
      {translate("form_label_subject")}
      <span class="error-msg text-base text-primary/60 transition-colors" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="subject"
      name="subject"
      class="w-full border border-black/30 bg-black/15 px-3.75 py-2.5 focus:ring-1 focus:ring-primary focus:border-transparent outline-none dark:border-white/30 dark:bg-white/15 transition-all"
      placeholder={translate("form_placeholder_subject")}
      required
      aria-required="true"
    />
  </section>

  <section class="group mb-3">
    <label for="message" class="block">
      {translate("form_label_message")}
      <span class="error-msg text-base text-primary/60 transition-colors" aria-hidden="true">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full resize-y border border-black/30 bg-black/15 px-3.75 py-2.5 focus:ring-1 focus:ring-primary focus:border-transparent outline-none dark:border-white/30 dark:bg-white/15 transition-all"
      placeholder={translate("form_placeholder_message")}
      required
      aria-required="true"></textarea>
  </section>

  <section class="flex gap-3 mb-7">
    <div class="flex h-5 items-center focus:border-transparent focus:ring-1 focus:ring-primary">
      <input
        id="terms"
        name="terms"
        type="checkbox"
        class="h-4 w-4 rounded border-zinc-300 text-primary focus:ring-primary"
        required
        aria-required="true"
      />
    </div>
    <label for="terms" class="text-xl/5.5 cursor-pointer select-none">
      {translate("form_terms")}
      <span class="error-msg text-base text-primary/60 transition-colors" aria-hidden="true">*</span>
    </label>
  </section>

  <button
    type="submit"
    id="submit-button"
    class="flex w-full justify-center bg-primary py-4 font-medium text-base text-black transition-all hover:brightness-110 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed"
  >
    <span id="submit-text" class="flex items-center gap-3">
      <span>{translate("form_button_send")}</span>
      <IconComponent icon="arrow-right" class="h-6.5 w-6.5" aria-hidden="true" />
    </span>
    <Spinner id="spinner" class="hidden h-6.5 w-6.5" aria-hidden="true" />
  </button>
</form>

<script is:inline src={RECAPTCHA_URL}></script>

<script>
  import { verifyRecaptcha } from "../services/recaptcha/recaptcha";
  import { sendEmail } from "../services/mail/mail.service";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-button") as HTMLButtonElement;
  const submitText = document.getElementById("submit-text");
  const spinner = document.getElementById("spinner");
  const RECAPTCHA_SITE_KEY = form?.dataset.recaptchaSiteKey!;
  const uiMessages = JSON.parse(form?.dataset.uiMessages || "{}");
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const setLoading = (isLoading: boolean) => {
    if (submitBtn) submitBtn.disabled = isLoading;
    if (isLoading) {
      submitText?.classList.add("hidden");
      spinner?.classList.remove("hidden");
    } else {
      submitText?.classList.remove("hidden");
      spinner?.classList.add("hidden");
    }
  };

  const validateField = (input: HTMLInputElement | HTMLTextAreaElement) => {
    const section = input.closest("section") || input.parentElement?.parentElement;
    const errorSpan = section?.querySelector(".error-msg");
    let isValid = true;
    let message = "*";

    if (input.required && (input.type === "checkbox" ? !(input as HTMLInputElement).checked : !input.value.trim())) {
      isValid = false;
      message = uiMessages.required;
    } else if (input.type === "email" && input.value.trim() !== "" && !emailRegex.test(input.value)) {
      isValid = false;
      message = uiMessages.email;
    }

    if (errorSpan) {
      errorSpan.textContent = message;
      if (!isValid) {
        errorSpan.classList.replace("text-primary/60", "text-red-500");
        input.classList.add("border-red-500", "focus:ring-red-500");
      } else {
        errorSpan.classList.replace("text-red-500", "text-primary/60");
        input.classList.remove("border-red-500", "focus:ring-red-500");
      }
    }

    return isValid;
  };

  form?.querySelectorAll("input, textarea").forEach((input) => {
    const element = input as HTMLInputElement | HTMLTextAreaElement;
    element.addEventListener("input", () => validateField(element));
    element.addEventListener("blur", () => validateField(element));
  });

  const waitForToast = (timeoutMs = 3000) => {
    return new Promise((resolve) => {
      if ((window as any).toast) return resolve(true);

      const interval = setInterval(() => {
        if ((window as any).toast) {
          clearInterval(interval);
          clearTimeout(timeout);
          resolve(true);
        }
      }, 50);

      const timeout = setTimeout(() => {
        clearInterval(interval);
        console.warn("Toast system did not load in time. Proceeding without showing toast notifications.");
        resolve(false);
      }, timeoutMs);
    });
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const inputs = Array.from(form.querySelectorAll("input, textarea")) as (HTMLInputElement | HTMLTextAreaElement)[];
    const isFormValid = inputs.map(validateField).every((res) => res);

    if (!isFormValid) {
      form.querySelector(".text-red-500")?.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    setLoading(true);

    try {
      if (typeof (window as any).grecaptcha === "undefined") {
        throw new Error("error_network");
      }

      const token = await new Promise<string>((resolve) => {
        (window as any).grecaptcha.ready(async () => {
          const t = await (window as any).grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: "submit" });
          resolve(t);
        });
      });

      const captchaRes = await verifyRecaptcha(token);
      if (!captchaRes.success) {
        throw new Error(captchaRes.errorType || "error_captcha");
      }

      const emailRes = await sendEmail(form);
      if (!emailRes.success) {
        throw new Error(emailRes.errorType || "error_mail");
      }

      const successMsg = uiMessages["form_success"];
      await waitForToast();
      (window as any).toast?.show(successMsg, "success");

      form.reset();
    } catch (error: any) {
      const errorKey = error.message || "error_network";
      const errorMsg = uiMessages[errorKey] || uiMessages["error_network"];
      await waitForToast();
      (window as any).toast?.show(errorMsg, "error");
    } finally {
      setLoading(false);
    }
  });
</script>
