---
import type { LocaleProps } from "../types";
import HamburguerButton from "./HamburguerButton.astro";
import NavIndex from "./NavIndex.astro";
import LanguagePicker from "./LanguagePicker.astro";
import ThemeButton from "./ThemeButton.astro";

interface Props extends LocaleProps {}

const { currentLang, translate } = Astro.props;
---

<section
  id="h-section"
  class="px-4.5 md:px-8 lg:px-16 pt-6 md:pt-8 lg:pt-12 max-w-352 mx-auto flex justify-between w-full"
>
  <p class="text-4.25xl lg:text-5xl font-workbench tracking-widest">AM</p>
  <nav class="flex items-center gap-1 md:gap-7">
    <ThemeButton class="hidden md:block p-1 rounded-lg" />
    <LanguagePicker currentLang={currentLang} translate={translate} />
    <HamburguerButton translate={translate} />
  </nav>
</section>

<NavIndex id="mobile-menu" class="hidden md:hidden my-auto" currentLang={currentLang} translate={translate} />
