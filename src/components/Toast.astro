<div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

<script is:inline>
  window.toast = {
    show(message, type = "success") {
      const container = document.getElementById("toast-container");

      if (!container) return;

      const toast = document.createElement("div");
      const bgColor = type === "success" ? "bg-primary text-black" : "bg-red-600 text-white";
      const icon = type === "success" ? "✅" : "❌";

      toast.className = `${bgColor} relative flex items-center gap-3 px-6 py-4 pr-12 rounded-lg shadow-xl translate-y-10 opacity-0 transition-all duration-300 ease-out pointer-events-auto border border-black/10`;
      toast.innerHTML = `
        <span class="text-xl">${icon}</span>
        <p class="font-medium">${message}</p>
        <button class="absolute right-3 top-1/2 -translate-y-1/2 cursor-pointer opacity-70 hover:opacity-100 p-1 text-lg leading-none" aria-label="Cerrar">&times;</button>
      `;

      container.appendChild(toast);

      const closeToast = () => {
        toast.classList.add("opacity-0", "scale-95");
        setTimeout(() => toast.remove(), 300);
      };

      toast.querySelector("button").onclick = (event) => {
        event.stopPropagation();
        closeToast();
      };

      requestAnimationFrame(() => toast.classList.remove("translate-y-10", "opacity-0"));
      setTimeout(closeToast, 5000);
    },
  };
</script>
