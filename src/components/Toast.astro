---
import IconComponent from "./IconComponent.astro";

const { translate } = Astro.props;
---

<aside
  id="toast-container"
  data-label-close={translate("button_close")}
  class="fixed bottom-8 right-0 px-4.5 md:px-8 lg:px-16 z-50 flex flex-col gap-3 pointer-events-none"
>
</aside>

<template id="toast-icons">
  <div id="icon-success">
    <span
      class="flex items-center justify-center rounded-lg bg-green-50 p-2 text-green-600 dark:bg-green-950/30 dark:text-green-400"
    >
      <IconComponent icon="check" class="h-5 w-5" />
    </span>
  </div>
  <div id="icon-error">
    <span
      class="flex items-center justify-center rounded-lg bg-red-50 p-2 text-red-600 dark:bg-red-950/30 dark:text-red-400"
    >
      <IconComponent icon="icon-x" class="h-5 w-5" />
    </span>
  </div>
  <span id="icon-close">
    <IconComponent icon="icon-x" class="h-5 w-5" />
  </span>
</template>

<script is:inline>
  window.toast = {
    show(message, type) {
      const container = document.getElementById("toast-container");
      const template = document.getElementById("toast-icons");
      if (!container || !template) return;

      const closeLabel = container.getAttribute("data-label-close");
      const toast = document.createElement("div");

      toast.setAttribute("role", type === "error" ? "alert" : "status");
      toast.setAttribute("aria-live", type === "error" ? "assertive" : "polite");
      toast.className = `
        pointer-events-auto flex gap-4 justify-between rounded-2xl border border-black/5 
        bg-white p-4 shadow-sm transition-all duration-300 ease-out 
        dark:border-white/10 dark:bg-black translate-y-4 opacity-0
      `;

      const iconHtml = template.content.querySelector(`#icon-${type}`).innerHTML;
      const closeIconHtml = template.content.querySelector(`#icon-close`).innerHTML;

      toast.innerHTML = `
        <p class="flex items-center gap-4 text-sm font-medium text-black dark:text-white">
          ${iconHtml}
          ${message}
        </p>
        <button 
          class="cursor-pointer rounded p-2 text-black/40 hover:text-black hover:bg-black/15 dark:text-white/40 dark:hover:text-white dark:hover:bg-white/15 transition-colors" 
          aria-label="${closeLabel}"
        >
          ${closeIconHtml}
        </button>
      `;

      container.appendChild(toast);

      const closeToast = () => {
        toast.classList.add("opacity-0", "translate-y-12", "scale-95");
        setTimeout(() => toast.remove(), 300);
      };

      toast.querySelector("button").onclick = (event) => {
        event.stopPropagation();
        closeToast();
      };

      requestAnimationFrame(() => {
        toast.classList.remove("translate-y-12", "opacity-0", "scale-95");
      });

      setTimeout(closeToast, 5000);
    },
  };
</script>
