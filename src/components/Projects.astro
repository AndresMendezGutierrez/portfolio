---
import ProjectCard from "./ProjectCard.astro";

const projects = [
  {
    title: "Portfolio Project",
    description: "My personal portfolio website built with Astro and Tailwind CSS.",
    tags: ["astro", "tailwind", "typescript"],
    repoUrl: "https://github.com/AndresMendezGutierrez/portfolio",
    imageUrl: "./images/portfolio.webp",
  },
  {
    title: "Portfolio Project",
    description: "My personal portfolio website built with Astro and Tailwind CSS.",
    tags: ["astro", "tailwind", "typescript"],
    repoUrl: "https://github.com/AndresMendezGutierrez/portfolio",
    imageUrl: "./images/portfolio.webp",
  },
  {
    title: "Portfolio Project",
    description: "My personal portfolio website built with Astro and Tailwind CSS.",
    tags: ["astro", "tailwind", "typescript"],
    repoUrl: "https://github.com/AndresMendezGutierrez/portfolio",
    imageUrl: "./images/portfolio.webp",
  },
];
const { translate } = Astro.props;
---

<header class="block gap-7">
  <h2 class="text-3.25xl">{translate("projects_title")}</h2>
  <p class="text-xl">{translate("projects_description")}</p>
</header>

<section class="w-full flex overflow-x-auto gap-8 lg:gap-9.5 py-8 scroll-smooth snap-x snap-mandatory hide-scrollbar">
  {
    projects.map((project) => (
      <div class="snap-center">
        {" "}
        <ProjectCard translate={translate} {...project} />
      </div>
    ))
  }
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
