---
import IconComponent from "./IconComponent.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  repoUrl?: string;
  webUrl?: string;
  imageUrl: string;
  translate: (key: string) => string;
}

const { title, description, tags, repoUrl, webUrl, imageUrl, translate } = Astro.props;
---

<article
  class="snap-center group shrink-0 max-w-76 md:max-w-80.5 flex flex-col border border-black/30 dark:border-white/30 bg-white dark:bg-black transition-all duration-300 hover:transform hover:scale-103 hover:bg-black/10 hover:dark:bg-white/15"
>
  <figure class="aspect-4/3 border-b border-black/30 dark:border-white/30 shrink-0">
    <img src={imageUrl} alt={`${translate("projects_image_alt")}${title}`} class="h-full w-full" loading="lazy" />
  </figure>

  <section class="py-5.5 px-4.5 flex flex-col flex-1 gap-4">
    <ul class="flex flex-wrap gap-2" aria-label={translate("projects_tags_label")}>
      {
        tags.map((tag) => (
          <li class="border border-black/20 dark:border-white/20 px-2 py-1 font-medium text-2xs tracking-small">
            {tag}
          </li>
        ))
      }
    </ul>

    <h3 class="text-2xl font-bold tracking-tight">
      {title}
    </h3>

    <p class="text-base leading-relaxed opacity-80 line-clamp-4 font-mono grow">
      {description}
    </p>

    <a
      href={repoUrl || webUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-auto flex items-center justify-center gap-3 border border-black dark:border-white py-3 px-6 text-sm font-medium tracking-[-0.32px] transition-all hover:bg-black/15 dark:hover:bg-white/20"
    >
      <span>{repoUrl ? translate("projects_repo") : translate("projects_link")}</span>
      <IconComponent icon="external-link" class="w-5 h-5" />
    </a>
  </section>
</article>
