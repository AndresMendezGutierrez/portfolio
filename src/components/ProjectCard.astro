---
// components/ProjectCard.astro
import IconComponent from "./IconComponent.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  repoUrl: string;
  imageUrl: string;
  translate: (key: string) => string;
}

const { title, description, tags, repoUrl, imageUrl, translate } = Astro.props;
---

<article
  class="group min-w-76 max-w-80.5 flex flex-col border border-black/30 dark:border-white/30 bg-white dark:bg-black transition-all duration-300 hover:bg-white/15 dark:hover:bg-black/15 hover:transform hover:scale-105"
>
  <figure class="aspect-4/3 overflow-hidden border-b border-black/30 dark:border-white/30">
    <img
      src={imageUrl}
      alt={`Captura de pantalla del proyecto ${title}`}
      class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105"
      loading="lazy"
    />
  </figure>
  <section class="py-5.5 px-4.5 flex flex-col gap-4 grow transition-colors duration-300">
    <ul class="flex flex-wrap gap-2" aria-label="Tecnologías usadas">
      {
        tags.map((tag) => (
          <li class="border border-black/20 dark:border-white/20 px-2 py-1 text-2xs tracking-small opacity-70">
            {tag}
          </li>
        ))
      }
    </ul>
    <h3 class="text-2xl font-bold tracking-tight">
      {title}
    </h3>

    <p class="text-base leading-relaxed opacity-80 line-clamp-4 grow font-mono">
      {description}
    </p>

    <a
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex items-center justify-center gap-3 border border-black dark:border-white py-3 px-6 text-sm font-medium tracking-widest transition-all hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black"
    >
      <span>{translate("projects_repo")}</span>
      <IconComponent icon="external-link" class="w-5 h-5" />
    </a>
  </section>
</article>
