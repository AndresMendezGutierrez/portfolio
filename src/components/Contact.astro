---
import IconComponent from "./IconComponent.astro";

const { translate } = Astro.props;
---

<header class="mb-14 text-center">
  <h2 id="contact-heading" class="mb-8 text-32 font-semibold tracking-tight">
    {translate("contact_title")}
  </h2>

  <menu aria-label={translate("contact_label_menu")} class="flex justify-center gap-6">
    <li>
      <a
        href="https://linkedin.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={translate("contact_label_linkedin")}
      >
        <IconComponent icon="linkedin-icon" class="h-16 w-16 transition-transform hover:scale-110" />
      </a>
    </li>
    <li>
      <a href="tel:+34910009718" aria-label={translate("contact_label_phone")}>
        <IconComponent icon="phone-icon" class="h-16 w-16 transition-transform hover:scale-110" />
      </a>
    </li>
    <li>
      <a
        href="https://github.com/AndresMendezGutierrez"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={translate("contact_label_github")}
      >
        <IconComponent icon="github-icon" class="h-16 w-16 transition-transform hover:scale-110" />
      </a>
    </li>
  </menu>
</header>

<section class="mb-12 text-center">
  <p class="text-32 font-semibold" role="presentation">
    {translate("contact_or")}
  </p>
  <p class="mt-6.5 text-xl/5.5">
    {translate("contact_email_instruction")}
  </p>
</section>

<form class="space-y-6 font-normal text-xl/10 px-6" action="/api/contact" method="POST">
  <section class="group mb-3">
    <label for="email" class="block">
      {translate("contact_label_email")}
      <span class="text-primary/60" aria-hidden="true">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      autocomplete="email"
      class="w-full border border-black/30 bg-black/15 px-3.75 py-2.5 focus:ring-1 focus:ring-primary focus:border-transparent outline-none dark:border-white/30 dark:bg-white/15 transition-all"
      placeholder={translate("contact_placeholder_email")}
      required
      aria-required="true"
    />
  </section>

  <section class="group mb-3">
    <label for="subject" class="block">
      {translate("contact_label_subject")}
      <span class="text-primary/60" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="subject"
      name="subject"
      class="w-full border border-black/30 bg-black/15 px-3.75 py-2.5 focus:ring-1 focus:ring-primary focus:border-transparent outline-none dark:border-white/30 dark:bg-white/15 transition-all"
      placeholder={translate("contact_placeholder_subject")}
      required
      aria-required="true"
    />
  </section>

  <section class="group mb-3">
    <label for="message" class="block">
      {translate("contact_label_message")}
      <span class="text-primary/60" aria-hidden="true">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      class="w-full resize-y border border-black/30 bg-black/15 px-3.75 py-2.5 focus:ring-1 focus:ring-primary focus:border-transparent outline-none dark:border-white/30 dark:bg-white/15 transition-all"
      placeholder={translate("contact_placeholder_message")}
      required
      aria-required="true"></textarea>
  </section>

  <section class="flex items-center gap-3 text-xl/5.5">
    <div class="flex h-5 items-center focus:border-transparent focus:ring-1 focus:ring-primary">
      <input
        id="terms"
        name="terms"
        type="checkbox"
        class="h-4 w-4 rounded border-zinc-300 text-primary focus:ring-primary"
        required
        aria-required="true"
      />
    </div>
    <label for="terms" class="cursor-pointer select-none">
      {translate("contact_terms")}
    </label>
  </section>

  <button
    type="submit"
    class="flex w-full items-center justify-center gap-3 bg-primary py-4 font-medium text-base text-black transition-all hover:brightness-110 active:scale-[0.98]"
  >
    <span>{translate("contact_button_send")}</span>
    <IconComponent icon="arrow-right" class="h-6.5 w-6.5" aria-hidden="true" />
  </button>
</form>
