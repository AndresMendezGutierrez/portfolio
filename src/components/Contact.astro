---
// components/Contact.astro
import IconComponent from "./IconComponent.astro";

const { translate } = Astro.props;
---

<header class="mb-8 text-center">
  <h3 class="mb-6 text-2xl font-medium">{translate("contact_title")}</h3>
  <menu class="flex justify-center gap-6">
    <li>
      <a href="#" aria-label="LinkedIn">
        <IconComponent icon="linkedin-icon" class="h-10 w-10 text-black dark:text-white" />
      </a>
    </li>
    <li>
      <a href="#" aria-label="Phone">
        <IconComponent icon="phone-icon" class="h-10 w-10 text-black dark:text-white" />
      </a>
    </li>
    <li>
      <a href="#" aria-label="GitHub">
        <IconComponent icon="github-icon" class="h-10 w-10 text-black dark:text-white" />
      </a>
    </li>
  </menu>
</header>

<div class="mb-8 text-center">
  <span class="text-xl font-bold">{translate("contact_or")}</span>
  <p class="mt-4 text-sm text-balance">
    {translate("contact_email_instruction")}
  </p>
</div>

<form class="space-y-5">
  <div>
    <label for="email" class="mb-2 block text-sm font-medium text-heading">
      {translate("contact_label_email")}
    </label>
    <input
      type="email"
      id="email"
      name="email"
      class="w-full rounded-sm border border-gray-300 bg-gray-200 px-3 py-3 text-sm placeholder:text-gray-500 focus:border-primary focus:outline-none dark:border-gray-700 dark:bg-neutral-800"
      placeholder={translate("contact_placeholder_email")}
      required
    />
  </div>

  <div>
    <label for="subject" class="mb-2 block text-sm font-medium text-heading">
      {translate("contact_label_subject")}
    </label>
    <input
      type="text"
      id="subject"
      name="subject"
      class="w-full rounded-sm border border-gray-300 bg-gray-200 px-3 py-3 text-sm placeholder:text-gray-500 focus:border-primary focus:outline-none dark:border-gray-700 dark:bg-neutral-800"
      placeholder={translate("contact_placeholder_subject")}
      required
    />
  </div>

  <div>
    <label for="message" class="mb-2 block text-sm font-medium text-heading">
      {translate("contact_label_message")}
    </label>
    <textarea
      id="message"
      name="message"
      rows="6"
      class="w-full resize-none rounded-sm border border-gray-300 bg-gray-200 px-3 py-3 text-sm placeholder:text-gray-500 focus:border-primary focus:outline-none dark:border-gray-700 dark:bg-neutral-800"
      placeholder={translate("contact_placeholder_message")}
      required></textarea>
  </div>

  <div class="flex items-center gap-3">
    <input id="terms" type="checkbox" class="h-4 w-4" required />
    <label for="terms" class="text-sm font-medium text-heading select-none">
      {translate("contact_terms")}
    </label>
  </div>

  <button
    type="submit"
    class="flex w-full items-center justify-center gap-2 rounded-sm bg-primary py-3 text-sm font-bold text-black transition-colors hover:bg-primary/80 focus:outline-none"
  >
    {translate("contact_button_send")}
    <IconComponent icon="arrow-right" class="h-6.5 w-6.5" />
  </button>
</form>
