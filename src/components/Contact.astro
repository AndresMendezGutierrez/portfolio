---
import Form from "./Form.astro";
import IconComponent from "./IconComponent.astro";

const { translate } = Astro.props;
---

<header class="mb-14 text-center">
  <h2 id="contact-heading" class="mb-8 text-32 font-semibold tracking-tight">
    {translate("contact_title")}
  </h2>

  <menu aria-label={translate("contact_label_menu")} class="flex justify-center gap-6">
    <li>
      <a
        href="https://linkedin.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={translate("contact_label_linkedin")}
      >
        <IconComponent icon="linkedin-icon" class="h-16 w-16 transition-transform hover:scale-110" />
      </a>
    </li>
    <li>
      <a href="tel:+34910009718" aria-label={translate("contact_label_phone")}>
        <IconComponent icon="phone-icon" class="h-16 w-16 transition-transform hover:scale-110" />
      </a>
    </li>
    <li>
      <a
        href="https://github.com/AndresMendezGutierrez"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={translate("contact_label_github")}
      >
        <IconComponent icon="github-icon" class="h-16 w-16 transition-transform hover:scale-110" />
      </a>
    </li>
  </menu>
</header>

<section class="mb-12 text-center">
  <p class="text-32 font-semibold" role="presentation">
    {translate("contact_or")}
  </p>
  <p class="mt-6.5 text-xl/5.5">
    {translate("contact_email_instruction")}
  </p>
</section>

<Form translate={translate} />
